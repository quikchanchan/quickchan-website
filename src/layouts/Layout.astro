---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const {
  title = "Quick Chan | Procurement & Supply Chain Professional",
  description = "Quick Chan is an MCIPS qualified procurement and supply chain professional specialising in supplier development, product sourcing and supply chain solutions across Mainland China, Taiwan and Vietnam.",
  image = "https://www.hywsource.com/og-image.jpg"
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1">

<title>{title}</title>

<meta
name="description"
content={description}>

<meta
name="author"
content="Quick Chan">

<meta
property="og:title"
content={title}>

<meta
property="og:description"
content={description}>

<meta
property="og:type"
content="website">

<meta
property="og:url"
content={canonicalURL}>

<meta
property="og:image"
content={image}>

<meta
name="twitter:card"
content="summary_large_image">

<meta
name="twitter:title"
content={title}>

<meta
name="twitter:description"
content={description}>

<meta
name="twitter:image"
content={image}>

<link
rel="canonical"
href={canonicalURL}>

</head>

<body>

<Header/>

<main>

<slot/>

</main>

<Footer/>

</body>

</html>

<style>

html{

scroll-behavior:smooth;

}

body{

margin:0;

font-family:
Inter,
system-ui,
Arial,
sans-serif;

color:#111;

background:white;

}

main{

max-width:1150px;

margin:auto;

padding:0 35px;

}

</style>