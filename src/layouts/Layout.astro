npm run build

---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title = "Quick Chan" } = Astro.props;
---

<!doctype html>
<html lang="en">

<head>

<meta charset="UTF-8" />

<meta 
name="viewport" 
content="width=device-width, initial-scale=1.0"
/>

<title>{title}</title>


<meta
name="description"
content="Quick Chan is a MCIPS qualified procurement professional and founder of HYWSource."
/>


<meta
name="author"
content="Quick Chan"
/>


</head>


<body>


<Header />


<main>

<slot />

</main>


<Footer />


</body>


</html>


<style>

body {

margin:0;
font-family:
Inter,
Arial,
Helvetica,
sans-serif;

color:#111;

}


main {

max-width:1100px;
margin:auto;
padding:40px;

}


</style>
