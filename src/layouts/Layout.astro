---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const {
  title = "Quick Chan | Procurement & Supply Chain Professional",
  description = "Quick Chan is an MCIPS qualified procurement and supply chain professional specialising in supplier development, product sourcing and supply chain solutions across Mainland China, Taiwan and Vietnam.",
  image = "https://www.hywsource.com/og-image.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link rel="icon" type="image/svg+xml" href="/favicon.svg">

<link rel="alternate icon" href="/favicon.ico">


<title>{title}</title>


<meta
name="description"
content={description}
/>


<meta
name="author"
content="Quick Chan"
/>


<meta
property="og:title"
content={title}
/>


<meta
property="og:description"
content={description}
/>


<meta
property="og:type"
content="website"
/>


<meta
property="og:url"
content={canonicalURL}
/>


<meta
property="og:image"
content={image}
/>


<meta
name="twitter:card"
content="summary_large_image"
/>


<link
rel="canonical"
href={canonicalURL}
/>


</head>


<body>


<Header />


<main>

<slot />

</main>


<Footer />


</body>


</html>



<style>


html {

scroll-behavior:smooth;

}



body {

margin:0;

font-family:
Inter,
"Helvetica Neue",
Arial,
sans-serif;

color:#111;

background:white;

line-height:1.6;

}



* {

box-sizing:border-box;

}



main {

max-width:1150px;

margin:auto;

padding:0 35px;

}



h1,
h2,
h3,
h4 {

font-weight:600;

line-height:1.25;

}



p {

line-height:1.8;

}



@media(max-width:768px){


body {

overflow-x:hidden;

}



main {

padding:0 18px;

}



h1 {

font-size:34px !important;

line-height:1.25;

}



h2 {

font-size:26px !important;

line-height:1.35;

}



h3 {

font-size:20px !important;

}



p {

font-size:16px !important;

line-height:1.7;

}



section {

padding-left:0 !important;

padding-right:0 !important;

}



.card {

padding:22px !important;

}



.hero {

padding-top:50px !important;

}



}


</style>