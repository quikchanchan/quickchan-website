---
import Layout from "../layouts/Layout.astro";

const experience = [
  {
    number: "15+",
    label: "Years Experience"
  },
  {
    number: "MCIPS",
    label: "Qualified Procurement Professional"
  },
  {
    number: "Asia",
    label: "Supply Chain Network"
  }
];

const locations = [
  "Mainland China",
  "Taiwan",
  "Vietnam"
];
---

<Layout
  title="Quick Chan | MCIPS Procurement & Supply Chain Professional"
  description="Quick Chan is an MCIPS qualified procurement and supply chain professional specialising in supplier development, product sourcing and supply chain solutions across Mainland China, Taiwan and Vietnam."
>

<main>


<!-- Hero -->

<section class="hero">

<div class="container hero-grid">

<div>

<p class="eyebrow">
QUICK CHAN | Procurement & Supply Chain Professional
</p>

<h1>
Quick Chan — MCIPS Procurement Professional
<br />
Helping Global Businesses Build Reliable Supply Chains
<br />
Across Mainland China, Taiwan and Vietnam.
</h1>

<p class="hero-text">

I'm Quick Chan, an MCIPS qualified procurement professional with 15+ years of experience helping businesses source better, reduce supply chain risks and develop reliable manufacturing partners across Mainland China, Taiwan and Vietnam.

</p>

<div class="hero-buttons">

<a href="/services" class="btn">
View Services
</a>

<a href="/contact" class="btn-outline">
Contact HYWSource
</a>

</div>

</div>

<div class="hero-image">

<img
src="/images/factory-production-line.jpg"
alt="Factory production line in China"
/>

</div>

</div>

</section>




<!-- Experience -->

<section class="experience-section">

<div class="container">


<div class="experience-grid">


{experience.map((item)=>(
<div class="experience-card">


<div class="experience-number">
{item.number}
</div>


<p>
{item.label}
</p>


</div>
))}


</div>


</div>

</section>





<!-- About -->

<section class="section">

<div class="container about-grid">


<div>

<p class="eyebrow">
ABOUT QUICK CHAN & HYWSource
</p>


<h2>
Building reliable supplier networks through HYWSource procurement expertise and manufacturing partnerships across Asia.
</h2>


</div>




<div>


<p>
I support international companies with sourcing, procurement and supply chain solutions across Asia.
</p>


<p>
My approach combines practical manufacturing experience with professional procurement methodology to help businesses identify suitable suppliers, improve purchasing decisions and manage supply chain risks.
</p>



<div class="location-list">


{locations.map((location)=>(
<span>
{location}
</span>
))}


</div>


</div>


</div>


</section>
<!-- Procurement Capabilities -->

<section class="section">

<div class="container">


<p class="eyebrow">
PROCUREMENT CAPABILITIES
</p>


<h2>
End-to-end procurement support from supplier selection to delivery.
</h2>



<div class="card-grid">


<div class="card">

<h3>
Strategic Sourcing
</h3>

<p>
Identify suitable suppliers, evaluate manufacturing capabilities and develop sourcing strategies aligned with business objectives.
</p>

</div>



<div class="card">

<h3>
Supplier Development
</h3>

<p>
Verify manufacturers, improve supplier relationships and build reliable long-term partnerships.
</p>

</div>




<div class="card">

<h3>
Product Development Support
</h3>

<p>
Support product customization, material selection, sampling and communication between buyers and manufacturers.
</p>

</div>




<div class="card">

<h3>
Cost Optimisation
</h3>

<p>
Improve purchasing decisions through supplier comparison, negotiation and total cost analysis.
</p>

</div>




<div class="card">

<h3>
Quality Assurance
</h3>

<p>
Coordinate inspections, production follow-up and quality control processes before shipment.
</p>

</div>




<div class="card">

<h3>
Supply Chain Risk Management
</h3>

<p>
Support supplier evaluation, alternative sourcing strategies and risk reduction across Asia.
</p>

</div>

<a href="/services">
View All Services →
</a>

</div>


</div>

</section>





<!-- How I Work -->

<section class="section">


<div class="container">


<p class="eyebrow">
HOW I WORK
</p>


<h2>
A structured sourcing process from requirements analysis to supplier management and delivery.
</h2>



<div class="process-grid">


<div class="process-item">

<span>
01
</span>

<h3>
Requirements Analysis
</h3>

<p>
Analyse product specifications, target market, quality expectations and commercial objectives.
</p>

</div>



<div class="process-item">

<span>
02
</span>

<h3>
Supplier Research & Verification
</h3>

<p>
Identify suitable manufacturers and verify production capability, experience and reliability.
</p>

</div>




<div class="process-item">

<span>
03
</span>

<h3>
Sampling & Negotiation
</h3>

<p>
Coordinate samples, improve specifications, negotiate pricing and optimise sourcing solutions.
</p>

</div>




<div class="process-item">

<span>
04
</span>

<h3>
Production Follow-up & Delivery
</h3>

<p>
Follow production progress, quality checkpoints and shipment coordination until completion.
</p>

</div>



</div>


</div>


</section>
<!-- Case Studies -->

<section class="section">

<div class="container">


<p class="eyebrow">
CASE STUDIES
</p>


<h2>
Real sourcing projects, supplier challenges and practical supply chain solutions.
</h2>



<div class="card-grid">


<div class="card">

<h3>
Supplier Development
</h3>

<p>
Helping clients identify suitable manufacturing partners, evaluate capabilities and establish reliable supplier relationships.
</p>


<a href="/case-study-supplier-development">
View Case Study →
</a>

</div>




<div class="card">

<h3>
Vietnam Sourcing Project
</h3>

<p>
Supporting alternative supply chain solutions beyond Mainland China through supplier research and local sourcing support.
</p>


<a href="/case-study-vietnam-sourcing">
View Case Study →
</a>

</div>





<div class="card">

<h3>
Supply Chain Risk Management
</h3>

<p>
Building resilient supply chains through supplier evaluation, risk planning and proactive sourcing strategies.
</p>


<a href="/case-study-supply-chain-risk-management">
View Case Study →
</a>

</div>


</div>


</div>


</section>







<!-- Insights -->

<section class="section">

<div class="container">


<p class="eyebrow">
INSIGHTS
</p>


<h2>
Procurement insights, sourcing strategies and supply chain knowledge.
</h2>




<div class="card-grid">


<div class="card">

<h3>
How to Select Reliable Suppliers in Mainland China
</h3>


<p>
Finding a factory is easy. Finding the right manufacturing partner requires verification, experience and a structured sourcing process.
</p>


<a href="/insights">
Read More →
</a>

</div>





<div class="card">

<h3>
Reducing Total Cost of Ownership in Global Sourcing
</h3>


<p>
The lowest unit price does not always mean the lowest cost. Smart sourcing considers quality, logistics, risks and long-term value.
</p>


<a href="/insights">
Read More →
</a>

</div>





<div class="card">

<h3>
Managing Supply Chain Risks Across Asia
</h3>


<p>
Building resilient supply chains requires better supplier selection, communication and proactive risk management.
</p>


<a href="/insights">
Read More →
</a>

</div>



</div>


</div>


</section>








<!-- CTA -->

<section class="section">


<div class="container">


<div class="dark-section">


<h2>
Looking for reliable sourcing support across Mainland China, Taiwan and Vietnam?
</h2>


<p>
Let's discuss your product requirements and explore how HYWSource can support your supply chain across Mainland China, Taiwan and Vietnam.
</p>



<a
href="/contact"
class="btn-white"
>
Contact HYWSource
</a>



</div>


</div>


</section>



</main>


</Layout>