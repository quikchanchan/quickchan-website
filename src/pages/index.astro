---
const siteUrl = "https://www.hywsource.com";

const services = [
  {
    title: "Supplier Selection & Management",
    text: "Identify reliable manufacturers, evaluate production capability, verify factories, and build long-term supplier relationships in China."
  },
  {
    title: "Product Development Assistance",
    text: "Support product customization, material selection, sampling, production communication, and manufacturing optimization."
  },
  {
    title: "Cost Optimization",
    text: "Improve purchasing decisions through market research, supplier comparison, negotiation, and total cost analysis."
  },
  {
    title: "Quality Assurance",
    text: "Coordinate inspections, production follow-up, quality control processes, and shipment readiness."
  },
  {
    title: "Supply Chain Coordination",
    text: "Manage communication between buyers, factories, logistics partners, and other stakeholders."
  },
  {
    title: "Market Research",
    text: "Provide China manufacturing insights, supplier intelligence, and sourcing recommendations."
  }
];

const industries = [
  "Home Decoration",
  "Furniture & Building Materials",
  "Packaging & Printing",
  "Consumer Products",
  "Small Appliances",
  "Retail & E-commerce Products"
];

const process = [
  {
    number: "01",
    title: "Understand Your Requirements",
    text: "Analyze product specifications, target market, quality expectations, and commercial objectives."
  },
  {
    number: "02",
    title: "Supplier Research & Verification",
    text: "Find suitable manufacturers and verify capability, experience, equipment, and production conditions."
  },
  {
    number: "03",
    title: "Sampling & Negotiation",
    text: "Coordinate prototypes, improve specifications, negotiate pricing, and optimize solutions."
  },
  {
    number: "04",
    title: "Production & Delivery",
    text: "Follow production progress, quality checkpoints, and shipment coordination until completion."
  }
];

const insights = [
  {
    title: "How to Select Reliable Suppliers in China",
    excerpt:
      "Finding a factory is easy. Finding the right manufacturing partner requires experience, verification, and a structured sourcing process.",
  },
  {
    title: "Reducing Total Cost of Ownership in Global Sourcing",
    excerpt:
      "The lowest unit price is not always the lowest cost. Smart sourcing considers quality, logistics, risks, and long-term value.",
  },
  {
    title: "Is a China Sourcing Partner Right for Your Business?",
    excerpt:
      "For international brands, the right local partner can simplify communication, reduce risks, and accelerate product development."
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
      HYWSource | China Sourcing & Procurement Partner
    </title>

    <meta
      name="description"
      content="HYWSource helps international businesses source products from China with professional procurement, supplier management, quality control and supply chain solutions."
    />

    <link rel="canonical" href={siteUrl} />
  </head>

  <body class="bg-white text-gray-900">

    <header class="border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-6 py-6 flex justify-between items-center">

        <a href="/" class="font-semibold text-xl tracking-tight">
          Quick Chan
          <span class="text-gray-400">|</span>
          HYWSource
        </a>

        <nav class="hidden md:flex gap-8 text-sm text-gray-600">
          <a href="#services" class="hover:text-black">Services</a>
          <a href="#process" class="hover:text-black">Process</a>
          <a href="#industries" class="hover:text-black">Industries</a>
          <a href="#insights" class="hover:text-black">Insights</a>
          <a href="/about" class="hover:text-black">About</a>
        </nav>

      </div>
    </header>


    <main>


      <!-- Hero -->

      <section class="max-w-7xl mx-auto px-6 pt-28 pb-24">

        <div class="max-w-4xl">

          <p class="text-sm uppercase tracking-[0.3em] text-gray-500 mb-8">
            China Sourcing · Procurement · Supply Chain
          </p>

          <h1 class="text-5xl md:text-7xl font-semibold leading-tight tracking-tight">
            Your trusted sourcing partner
            <br />
            in China.
          </h1>

          <p class="mt-8 text-xl text-gray-600 leading-relaxed max-w-3xl">
            HYWSource helps global brands discover reliable manufacturers,
            optimize costs, manage suppliers, and build stronger supply chains
            through professional China sourcing expertise.
          </p>


          <div class="mt-10 flex flex-wrap gap-4">

            <a
              href="/contact"
              class="bg-black text-white px-8 py-4 rounded-full text-sm hover:opacity-80 transition"
            >
              Start Your Sourcing Project
            </a>


            <a
              href="/about"
              class="border border-gray-300 px-8 py-4 rounded-full text-sm hover:border-black transition"
            >
              Learn More
            </a>

          </div>

        </div>

      </section>




      <!-- Services -->

      <section id="services" class="bg-gray-50 py-24">

        <div class="max-w-7xl mx-auto px-6">

          <div class="max-w-3xl mb-14">

            <p class="text-sm uppercase tracking-widest text-gray-500">
              Services
            </p>

            <h2 class="text-4xl font-semibold mt-4">
              Professional sourcing support from China
            </h2>

          </div>


          <div class="grid md:grid-cols-3 gap-8">

            {
              services.map(service => (
                <div class="bg-white p-8 rounded-2xl border border-gray-100">

                  <h3 class="text-xl font-medium mb-4">
                    {service.title}
                  </h3>

                  <p class="text-gray-600 leading-relaxed">
                    {service.text}
                  </p>

                </div>
              ))
            }

          </div>

        </div>

      </section>





      <!-- Why -->

      <section class="max-w-7xl mx-auto px-6 py-24">

        <div class="grid md:grid-cols-2 gap-16 items-center">


          <div>

            <p class="text-sm uppercase tracking-widest text-gray-500">
              Why HYWSource
            </p>

            <h2 class="text-4xl font-semibold mt-5 leading-tight">
              Experience beyond supplier searching
            </h2>

          </div>



          <div class="space-y-6 text-gray-600 leading-relaxed">

            <p>
              With professional procurement and supply chain experience,
              HYWSource focuses on creating practical sourcing solutions,
              not simply connecting buyers with factories.
            </p>

            <p>
              We combine manufacturing knowledge, supplier evaluation,
              commercial negotiation, and project management to help
              international businesses reduce risks when sourcing from China.
            </p>


            <p>
              From first supplier research to final shipment coordination,
              we support every important stage of the sourcing journey.
            </p>

          </div>


        </div>

      </section>





      <!-- Process -->

      <section id="process" class="bg-black text-white py-24">

        <div class="max-w-7xl mx-auto px-6">


          <div class="max-w-3xl mb-16">

            <p class="text-sm uppercase tracking-widest text-gray-400">
              Our Process
            </p>

            <h2 class="text-4xl font-semibold mt-4">
              A structured approach to sourcing
            </h2>

          </div>



          <div class="grid md:grid-cols-4 gap-8">

            {
              process.map(item => (

                <div>

                  <div class="text-gray-400 text-sm mb-5">
                    {item.number}
                  </div>

                  <h3 class="text-xl font-medium mb-4">
                    {item.title}
                  </h3>

                  <p class="text-gray-400 leading-relaxed">
                    {item.text}
                  </p>

                </div>

              ))
            }

          </div>


        </div>

      </section>





      <!-- Industries -->

      <section id="industries" class="max-w-7xl mx-auto px-6 py-24">


        <p class="text-sm uppercase tracking-widest text-gray-500">
          Industries
        </p>


        <h2 class="text-4xl font-semibold mt-5 mb-12">
          Products we support
        </h2>


        <div class="grid md:grid-cols-3 gap-5">

          {
            industries.map(industry => (

              <div class="border border-gray-200 rounded-xl px-6 py-8 text-lg">
                {industry}
              </div>

            ))
          }

        </div>


      </section>





      <!-- Insights -->

      <section id="insights" class="bg-gray-50 py-24">

        <div class="max-w-7xl mx-auto px-6">


          <div class="flex justify-between items-end mb-12">


            <div>

              <p class="text-sm uppercase tracking-widest text-gray-500">
                Insights
              </p>

              <h2 class="text-4xl font-semibold mt-4">
                From Quick Chan Journal
              </h2>

            </div>


          </div>



          <div class="grid md:grid-cols-3 gap-8">

            {
              insights.map(post => (

                <article class="bg-white rounded-2xl p-8 border border-gray-100">

                  <h3 class="text-xl font-medium mb-4">
                    {post.title}
                  </h3>

                  <p class="text-gray-600 leading-relaxed mb-6">
                    {post.excerpt}
                  </p>


                  <a
                    href="https://quickchan.substack.com"
                    target="_blank"
                    class="text-sm underline underline-offset-4"
                  >
                    Read on Substack
                  </a>


                </article>

              ))
            }


          </div>


        </div>

      </section>





      <!-- CTA -->

      <section class="max-w-7xl mx-auto px-6 py-28">


        <div class="bg-gray-900 text-white rounded-3xl p-12 md:p-20">


          <h2 class="text-4xl md:text-5xl font-semibold max-w-3xl">
            Looking for reliable sourcing support in China?
          </h2>


          <p class="mt-6 text-gray-300 text-lg max-w-2xl">
            Let's discuss your product requirements and explore how HYWSource
            can support your supply chain.
          </p>


          <a
            href="/contact"
            class="inline-block mt-10 bg-white text-black px-8 py-4 rounded-full"
          >
            Contact HYWSource
          </a>


        </div>


      </section>


    </main>





    <footer class="border-t border-gray-100">

      <div class="max-w-7xl mx-auto px-6 py-10 flex flex-col md:flex-row justify-between gap-6">


        <div>

          <div class="font-semibold">
            Quick Chan | HYWSource
          </div>

          <p class="text-sm text-gray-500 mt-2">
            China sourcing and procurement solutions.
          </p>

        </div>


        <div class="text-sm text-gray-500">

          © {new Date().getFullYear()} HYWSource.
          <br />
          www.hywsource.com

        </div>


      </div>


    </footer>


  </body>
</html>
