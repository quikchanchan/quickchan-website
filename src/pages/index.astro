---
import Layout from "../layouts/Layout.astro";

const experience = [
  {
    number: "15+",
    label: "Years Experience"
  },
  {
    number: "MCIPS",
    label: "Qualified Procurement Professional"
  },
  {
    number: "Asia",
    label: "Supply Chain Network"
  }
];

const locations = [
  "Mainland China",
  "Taiwan",
  "Vietnam"
];
---

<Layout
  title="Quick Chan | MCIPS Procurement & Supply Chain Professional"
  description="Quick Chan is an MCIPS qualified procurement and supply chain professional specialising in supplier development, product sourcing and supply chain solutions across Mainland China, Taiwan and Vietnam."
>

<main>


<!-- Hero -->

<section
  class="hero"
  style="background-image:url('/images/factory-production-line.jpg');"
>

<div class="hero-overlay"></div>

<div class="container hero-content">

<p class="eyebrow">
QUICK CHAN | MCIPS PROCUREMENT PROFESSIONAL
</p>

<h1>
Procurement & Supply Chain Solutions
<br>
Across Mainland China, Taiwan and Vietnam
</h1>

<p class="hero-text">
15+ years of procurement and sourcing experience helping international buyers build reliable supplier networks, manage sourcing risks and improve supply chain performance across Mainland China, Taiwan and Vietnam.
</p>

<div class="hero-buttons">

<a href="/services" class="btn">
View Services
</a>

<a href="/contact" class="btn-outline-white">
Contact HYWSource
</a>

</div>

</div>

</section>




<!-- Experience -->

<section class="hero-features">

<div class="container">

<div class="feature-item">

<h3>15+ Years Experience</h3>

<p>
Supporting international buyers with sourcing, procurement and supplier management across Asia.
</p>

</div>

<div class="feature-item">

<h3>MCIPS Qualified</h3>

<p>
Applying globally recognised procurement methodology to supplier evaluation and purchasing decisions.
</p>

</div>

<div class="feature-item">

<h3>Reliable Supplier Network</h3>

<p>
Established sourcing resources across Mainland China, Taiwan and Vietnam.
</p>

</div>

<div class="feature-item">

<h3>End-to-End Support</h3>

<p>
From supplier identification and factory audits to production follow-up and shipment coordination.
</p>

</div>

</div>

</section>





<!-- About -->

<section class="section">

<div class="container about-grid">


<div>

<p class="eyebrow">
ABOUT QUICK CHAN & HYWSource
</p>


<h2>
Building reliable supplier networks through HYWSource procurement expertise and manufacturing partnerships across Asia.
</h2>


</div>




<div>


<p>
I support international companies with sourcing, procurement and supply chain solutions across Mainland China, Taiwan and Vietnam.
</p>


<p>
As an MCIPS qualified procurement professional, I combine practical manufacturing experience with structured procurement methodologies to help businesses identify suitable suppliers, evaluate capabilities, reduce sourcing risks and build reliable long-term supply partnerships.
</p>



<div class="location-list">


{locations.map((location)=>(
<span>
{location}
</span>
))}


</div>


</div>


</div>


</section>
<!-- Procurement Capabilities -->

<section class="section">

<div class="container">


<p class="eyebrow">
PROCUREMENT CAPABILITIES
</p>


<h2>
End-to-end procurement support from supplier selection to delivery.
</h2>



<div class="card-grid">


<div class="card">

<h3>
Strategic Sourcing
</h3>

<p>
Identify suitable suppliers, evaluate manufacturing capabilities and develop sourcing strategies aligned with business objectives.
</p>

</div>



<div class="card">

<h3>
Supplier Evaluation & Verification
</h3>

<p>
Assess supplier capabilities, manufacturing experience, quality systems and production resources to identify reliable business partners.
</p>

</div>




<div class="card">

<h3>
Product Development & Sourcing Support
</h3>

<p>
Support product customization, material selection, sampling and communication between buyers and manufacturers.
</p>

</div>

<div class="card">

<h3>
Supplier Development
</h3>

<p>
Develop supplier relationships, improve communication and support manufacturers in meeting buyer requirements.
</p>

</div>


<div class="card">

<h3>
Cost Optimisation
</h3>

<p>
Improve purchasing decisions through supplier comparison, negotiation and total cost analysis.
</p>

</div>




<div class="card">

<h3>
Quality Assurance
</h3>

<p>
Coordinate inspections, production follow-up and quality control processes before shipment.
</p>

</div>




<div class="card">

<h3>
Supply Chain Risk Management
</h3>

<p>
Support supplier evaluation, alternative sourcing strategies and risk reduction across Asia.
</p>

</div>

<a href="/services">
View All Services →
</a>

</div>


</div>

</section>





<!-- How I Work -->

<section class="section">


<div class="container">


<p class="eyebrow">
HOW I WORK
</p>


<h2>
A structured sourcing process from requirements analysis to supplier management and delivery.
</h2>



<div class="process-grid">


<div class="process-item">

<span>
01
</span>

<h3>
Procurement Requirement Analysis
</h3>

<p>
Analyse product specifications, business objectives, quality expectations and supply chain requirements to define the right sourcing strategy.
</p>

</div>



<div class="process-item">

<span>
02
</span>

<h3>
Supplier Identification & Capability Assessment
</h3>

<p>
Identify suitable manufacturers and evaluate production capability, experience, quality systems and business suitability.
</p>

</div>




<div class="process-item">

<span>
03
</span>

<h3>
Commercial Evaluation & Supplier Negotiation
</h3>

<p>
Coordinate samples, evaluate commercial options, negotiate pricing and develop sourcing solutions aligned with business goals.
</p>

</div>




<div class="process-item">

<span>
04
</span>

<h3>
Production Management & Supply Chain Coordination
</h3>

<p>
Monitor production progress, quality checkpoints and shipment coordination to ensure smooth execution from supplier to delivery.
</p>

</div>



</div>


</div>


